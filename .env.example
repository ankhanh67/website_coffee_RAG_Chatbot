# --- LLM API (OpenRouter, OpenAI-compatible; key from https://openrouter.ai/keys) ---
LLM_API_KEY=sk-or-v1-your-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# Router uses Jev (TypeSafe System One) through OpenRouter, same API key
LLM_ROUTER_MODEL=~typesafe/jev-latest
LLM_GENERATOR_MODEL=google/gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
VECTOR_DIMENSIONS=768

# --- Neo4j Aura ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Timeouts (seconds) & thresholds ---
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
CACHE_SIMILARITY_THRESHOLD=0.90
ROUTER_CONFIDENCE_THRESHOLD=0.5
